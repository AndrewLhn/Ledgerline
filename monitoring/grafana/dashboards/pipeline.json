{
  "uid": "ledgerline-pipeline",
  "title": "Ledgerline pipeline",
  "tags": ["ledgerline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer lag, main topic",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag{topic=\"ledgerline_events\"})",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DLQ size",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"ledgerline_events_dlq\"})",
          "legendFormat": "messages"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last batch: read / written / rejected",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "ledgerline_batch_records_read", "legendFormat": "read"},
        {"refId": "B", "expr": "ledgerline_batch_records_written", "legendFormat": "written"},
        {"refId": "C", "expr": "ledgerline_batch_records_rejected", "legendFormat": "rejected"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Batch duration",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "ledgerline_batch_duration_seconds", "legendFormat": "seconds"}
      ]
    }
  ]
}
