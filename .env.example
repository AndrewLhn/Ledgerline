# Copy this file to .env. Do not commit .env.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=airflow
ICEBERG_CATALOG_DB=iceberg_metadata

# Iceberg catalog database roles (least privilege, see docs/security.md)
ICEBERG_DB_USER=iceberg
ICEBERG_DB_PASSWORD=change-this-iceberg-password
TRINO_DB_USER=trino
TRINO_DB_PASSWORD=change-this-trino-password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password

# Only used with the "monitoring" compose profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
